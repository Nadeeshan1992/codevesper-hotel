# ==========================================================
# CodeVesper Hotel & Restaurant Management Suite
# Vercel Environment Variables Template
# ==========================================================

# Database Connection (Choose Option A or Option B)

# --- Option A: Single Database URI (Railway, PlanetScale, TiDB, Aiven) ---
# DATABASE_URL=mysql://root:password@ep-sample-1234.us-east-1.aws.tidbcloud.com:4000/hotel_db

# --- Option B: Individual DB Variables ---
DB_HOST=your-mysql-cloud-host.com
DB_PORT=3306
DB_NAME=hotel_db
DB_USER=your_username
DB_PASS=your_password
DB_CHARSET=utf8mb4

# Application Secret Key for Secure Cookie Sessions
APP_KEY=codevesper_super_secret_production_key_2026_xyz

# Your Vercel Production Domain (without trailing slash)
APP_URL=https://codevesper-hotel.vercel.app
